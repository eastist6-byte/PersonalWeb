---
import Layout from '../layouts/Layout.astro';
import {url} from '../lib/content';
import {text} from '../lib/copy';
---
<Layout title={text.notFound.title}><div class="page-width not-found"><span class="eyebrow">404</span><h1>{text.notFound.heading}</h1><p>{text.notFound.description}</p><a class="button primary" href={url()}>{text.notFound.back} →</a></div></Layout>
